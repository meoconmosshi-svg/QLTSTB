# ============================================================
#  QLTSTB - Java Swing asset management (Ant / NetBeans)
# ============================================================

# ---- Ant build output ---------------------------------------------
/build/
/dist/

# ---- NetBeans: generated / machine-local --------------------------
# build-impl.xml and genfiles.properties are regenerated by NetBeans
# from project.xml + project.properties.
/nbproject/build-impl.xml
/nbproject/genfiles.properties
# private/ holds machine-specific paths, bookmarks and open-file lists
/nbproject/private/
/.netbeans/
/nbactions.xml

# ---- Compiled classes (safety net for out-of-tree builds) ---------
*.class

# ---- Other IDEs / editors -----------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
*.swp
*~

# ---- OS ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Logs / crash dumps --------------------------------------------
*.log
hs_err_pid*.log
replay_pid*.log

# ---- Dependencies: INTENTIONALLY TRACKED ---------------------------
# The SQL Server JDBC driver is committed so a fresh clone builds with
# no extra steps. Do not add a global *.jar rule above this line.
!/lib/**/*.jar